{
  "manifest_version": 3,
  "name": "Domour Copilot Extension",
  "version": "1.1.0",
  "description": "Secure Edge Extension AI Browser Automation Bridge",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "proxy",
    "tabGroups",
    "nativeMessaging",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Domour Copilot",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
